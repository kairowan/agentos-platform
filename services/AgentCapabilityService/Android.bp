android_app {
    name: "AgentCapabilityService",
    package_name: "com.agentos.capability",
    srcs: ["src/**/*.kt"],
    manifest: "AndroidManifest.xml",
    static_libs: [
        "AgentCapabilityApi",
        "AgentCapabilityCore",
    ],
    certificate: "platform",
    privileged: true,
    product_specific: true,
    platform_apis: true,
    kotlincflags: ["-Xjvm-default=all"],
}
