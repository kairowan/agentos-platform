<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="com.agentos.permission.USE_CAPABILITY_BROKER"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:label="AgentOS Capability Service"
        android:supportsRtl="true">
        <service
            android:name=".service.AgentCapabilityService"
            android:exported="true"
            android:permission="com.agentos.permission.USE_CAPABILITY_BROKER" />
        <service
            android:name=".service.AgentAppBridgeService"
            android:exported="true"
            android:permission="com.agentos.permission.USE_CAPABILITY_BROKER" />
        <service
            android:name=".service.AgentAppAccessibilityService"
            android:exported="true"
            android:label="AgentOS 应用语义桥"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_bridge_accessibility" />
        </service>
        <service
            android:name=".service.AgentNotificationListenerService"
            android:exported="true"
            android:label="AgentOS 消息通知"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
